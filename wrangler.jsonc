// Cloudflare Workers config for Vibe Code Academy (ARTEZIQ).
// The whole app is static files, served straight from the repo root.
// Files listed in .assetsignore (repo tools, docs) are NOT published.
{
  "name": "vibe-code-academy",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
